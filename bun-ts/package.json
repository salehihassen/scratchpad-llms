{
  "name": "bun-ts",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:basic-openrouter": "bun run openrouter-basic/completion.ts",
    "dev:stream-openrouter": "bun run openrouter-basic/stream.ts",
    "newsletter:dry": "bun run newsletter-summarizer/main.ts --dry-run",
    "newsletter:run": "bun run newsletter-summarizer/main.ts",
    "typecheck": "tsc --noEmit ",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"*/**/*.ts\" \"shared/**/*.ts\"",
    "format:fix": "prettier --write \"*/**/*.ts\" \"shared/**/*.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "^25.2.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.19.0"
  },
  "peerDependencies": {
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@openrouter/sdk": "^0.8.0",
    "dotenv": "^17.2.4",
    "imapflow": "^1.2.9",
    "mailparser": "^3.9.3",
    "openai": "^6.19.0",
    "zod": "^4.3.6"
  }
}
